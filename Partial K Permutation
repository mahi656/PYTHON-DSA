def findKPerm(nums ,k):
    n=len(nums)
    result=[]
    def backtrack(start,path):
        if start==k:
            result.append(path[:k])
            return
        for i in range(start,n):
            nums[start],nums[i]=nums[i],nums[start]
            path.append(nums[start])
            backtrack(start+1,path)
            path.pop()
            nums[start],nums[i]=nums[i],nums[start]
    backtrack(0,[])
    return result
