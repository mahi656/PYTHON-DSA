def permute(nums):
    n=len(nums)
    if n==0:
        return []
    if n==1:
        return [nums]
    result=[]
    def backtrack(start):
        if start==len(nums):
            result.append(nums[:])
        for i in range(start,n):
            nums[start],nums[i]=nums[i],nums[start]
            backtrack(start+1)
            nums[start],nums[i]=nums[i],nums[start]
    backtrack(0)
    return result
